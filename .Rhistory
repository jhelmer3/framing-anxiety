options(mc.cores = parallel::detectCores())
rstan_options(auto_write = T)
#| message: false
#| code-fold: show
dat_full <- qualtRics::read_survey(here::here("..", "Data", "prolific_2026.04.10.csv")) |>
mutate(id = row_number(),
.keep = "unused") |>
filter(Progress == 100)
#| code-fold: show
if (!file.exists(here::here("Models"))) dir.create(here::here("Models"))
BIS <- dat_full |>
select(id, starts_with("BIS"), -matches("BISBAS_T"), -matches("BISBAS_attention")) |>
mutate(across(!id, ~ recode_values(.x,
"Very true for me" ~ 4,
"Somewhat true for me" ~ 3,
"Somewhat false for me" ~ 2,
"Very false for me" ~ 1))) |>
mutate(across(ends_with("_r"), ~ 5 - .x,
.names = "{str_replace(.col, '_r', '')}"),
.keep = "unused")
imap(BIS |> select(-id), \(data, var) tibble(data) |>
ggplot(aes(x = data)) +
geom_bar() +
labs(x = var) +
scale_x_continuous(limits = c(0.5, 4.5),
breaks = 1:5) +
scale_y_continuous(NULL,
breaks = NULL) +
guides(x = guide_axis(cap = "both")) +
theme_classic(base_size = 12) +
theme(axis.line.y = element_blank())) |>
wrap_plots()
BIS_model <- BIS |>
select(-id) |>
names() |>
paste(collapse = " + ") |>
paste("BIS =~ ", ... = _)
lavaan::cfa(model = BIS_model,
data = BIS,
estimator = "MLR") |>
semPlot::semPaths(what = "std")
gr_BIS <- rstan::stan(file = here::here("Models", "graded-response_2pl_code.stan"),
data = list(K = 4,
N_student = nrow(BIS),
N_item = ncol(BIS) - 1, # taking out id column
Y = BIS |> select(-id)))
summary(gr_BIS)
gr_BIS
