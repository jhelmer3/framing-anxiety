library(tidyverse)
library(patchwork)
library(gt)
#| message: false
#| code-fold: show
dat_full <- qualtRics::read_survey(here::here("..", "Data", "prolific_2026.04.10.csv")) |>
mutate(id = row_number(),
.keep = "unused") |>
filter(Progress == 100)
STAI <- dat_full |>
select(id, starts_with("STAI"), -matches("STAI-T_T"), -matches("STAI-T_attention")) |>
mutate(across(!id, ~ recode_values(.x,
"Almost never" ~ 4,
"Often" ~ 3,
"Sometimes" ~ 2,
"Almost always" ~ 1))) |>
mutate(across(ends_with("_r"), ~ 5 - .x,
.names = "{str_replace(.col, '_r', '')}"),
.keep = "unused") |>
rename_with(~ str_replace(.x, "-T", ""),
everything())
imap(STAI |> select(-id), \(data, var) tibble(data) |>
ggplot(aes(x = data)) +
geom_bar() +
labs(x = var) +
scale_x_continuous(limits = c(0.5, 4.5),
breaks = 1:5) +
scale_y_continuous(NULL,
breaks = NULL) +
guides(x = guide_axis(cap = "both")) +
theme_classic(base_size = 12) +
theme(axis.line.y = element_blank())) |>
wrap_plots()
BIS <- dat_full |>
select(id, starts_with("BIS"), -matches("BISBAS_T"), -matches("BISBAS_attention")) |>
mutate(across(!id, ~ recode_values(.x,
"Very true for me" ~ 4,
"Somewhat true for me" ~ 3,
"Somewhat false for me" ~ 2,
"Very false for me" ~ 1))) |>
mutate(across(ends_with("_r"), ~ 5 - .x,
.names = "{str_replace(.col, '_r', '')}"),
.keep = "unused")
imap(BIS |> select(-id), \(data, var) tibble(data) |>
ggplot(aes(x = data)) +
geom_bar() +
labs(x = var) +
scale_x_continuous(limits = c(0.5, 4.5),
breaks = 1:5) +
scale_y_continuous(NULL,
breaks = NULL) +
guides(x = guide_axis(cap = "both")) +
theme_classic(base_size = 12) +
theme(axis.line.y = element_blank())) |>
wrap_plots()
